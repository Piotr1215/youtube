digraph architecture {
  rankdir=TB;
  node [shape=box];

  platform [label="vCluster Platform\njoin tokens + VPN\nhealth checks"];
  users [label="Developers and users\nkubectl, apps, tests"];
  cluster [label="Dev cluster\nAPI server + workers\nyour app"];
  gpu [label="GPU node\nkubelet\nmodel server"];

  platform -> cluster [label="coordinate", style=dashed];
  platform -> gpu [label="join", style=dashed];
  users -> cluster [label="kube context"];
  cluster -> gpu [label="model endpoint\nover the VPN"];
}
