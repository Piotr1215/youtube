digraph snippet_expansion {
  rankdir=LR;
  node [shape=box];

  trigger [label="iferr\nbefore cursor"];
  lookup [label="go snippets\ntop priority"];
  fields [label="fields\nM-l next\nM-j choice"];
  done [label="done\nlast M-l"];

  trigger -> lookup [label="M-l"];
  lookup -> fields;
  fields -> done;
}
