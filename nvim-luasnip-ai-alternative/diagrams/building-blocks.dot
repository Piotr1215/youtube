digraph building_blocks {
  rankdir=LR;
  node [shape=box];

  tree [label="syntax tree\ncode as nodes"];
  rule [label="ast-grep rule\nfinds a shape"];
  model [label="classif\njudges it"];
  fix [label="gra\nfixes it"];

  tree -> rule;
  rule -> fix [label="fix:"];
  rule -> model [label="ask:"];
  model -> fix [label="no"];
}
