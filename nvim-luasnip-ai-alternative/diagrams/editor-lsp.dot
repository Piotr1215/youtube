digraph editor_lsp {
  rankdir=LR;
  node [shape=box];

  rule [label="rule\nmessage:\nfix:"];
  lsp [label="ast-grep lsp\nin Neovim"];
  diag [label="diagnostic\nthe message"];
  action [label="code action\nthe fix"];
  gra [label="gra\napplies it"];
  cli [label="ast-grep scan -U\nfrom the shell"];
  files [label="files\nrewritten"];

  rule -> lsp;
  lsp -> diag;
  lsp -> action -> gra;
  rule -> cli -> files;
}
