digraph syntax_tree {
  rankdir=LR;
  node [shape=box];

  ifs [label="if_statement"];
  cond [label="binary_expression\nerr != nil"];
  body [label="block\n{ ... }"];
  left [label="identifier\nerr"];
  right [label="nil"];
  ret [label="return_statement\nnil, err"];

  ifs -> cond [label="condition"];
  ifs -> body [label="consequence"];
  cond -> left [label="left"];
  cond -> right [label="right"];
  body -> ret;
}
